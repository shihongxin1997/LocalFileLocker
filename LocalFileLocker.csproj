  <ItemGroup>
    <EditorConfigFiles Remove="E:\Share\LocalFileLocker\.editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <None Include="E:\Share\LocalFileLocker\.editorconfig" />
  </ItemGroup>

